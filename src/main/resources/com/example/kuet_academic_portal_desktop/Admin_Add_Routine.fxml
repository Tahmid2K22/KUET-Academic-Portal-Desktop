<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="800.0" prefWidth="1200.0" spacing="20" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kuet_academic_portal_desktop.Controller.AddRoutineController">
    <padding>
        <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
    </padding>
    <children>
        <Label styleClass="form-title" stylesheets="@CSS/admin_dashboard.css" text="Add Class Routine">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <VBox prefWidth="700.0" spacing="20" styleClass="admin-form-container" stylesheets="@CSS/admin_dashboard.css">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" text="Day:" />
                                <ComboBox fx:id="dayCombo" prefHeight="40" prefWidth="330" promptText="Select Day" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" text="Time Slot:" />
                                <TextField fx:id="timeField" prefHeight="40" promptText="e.g., 8:00 AM - 9:30 AM" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" text="Course Number:" />
                                <TextField fx:id="courseNoField" prefHeight="40" promptText="e.g., CSE 2201" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" text="Course Name:" />
                                <TextField fx:id="courseNameField" prefHeight="40" promptText="e.g., Advanced Programming" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" text="Teacher:" />
                                <TextField fx:id="teacherField" prefHeight="40" promptText="Teacher name" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" text="Room:" />
                                <TextField fx:id="roomField" prefHeight="40" promptText="e.g., AB1-201" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" text="Year:" />
                                <ComboBox fx:id="yearCombo" prefHeight="40" prefWidth="160" promptText="Select Year" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" text="Term:" />
                                <ComboBox fx:id="termCombo" prefHeight="40" prefWidth="160" promptText="Select Term" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" text="Department:" />
                                <ComboBox fx:id="departmentCombo" prefHeight="40" prefWidth="160" promptText="Select Dept" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" text="Section:" />
                                <ComboBox fx:id="sectionCombo" prefHeight="40" prefWidth="160" promptText="Select Section" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="15">
                    <padding>
                        <Insets top="20.0" />
                    </padding>
                    <children>
                        <Button onAction="#handleSubmit" prefHeight="45" prefWidth="180" styleClass="admin-submit-button" stylesheets="@CSS/admin_dashboard.css" text="Add" />
                        <Button onAction="#clearForm" prefHeight="45" prefWidth="180" styleClass="admin-cancel-button" stylesheets="@CSS/admin_dashboard.css" text="Clear Form" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
