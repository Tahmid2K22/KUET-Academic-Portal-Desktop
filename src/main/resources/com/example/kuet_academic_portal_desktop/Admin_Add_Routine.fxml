<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kuet_academic_portal_desktop.Controller.AdminDashboardController">
    <padding>
        <Insets top="30.0" left="50.0" right="50.0" bottom="30.0" />
    </padding>
    <children>
        <Label text="Add Class Routine" styleClass="form-title" stylesheets="@CSS/admin_dashboard.css">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <VBox spacing="20" styleClass="admin-form-container" stylesheets="@CSS/admin_dashboard.css" prefWidth="700">
            <padding>
                <Insets top="30.0" left="30.0" right="30.0" bottom="30.0" />
            </padding>
            <children>
                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Day:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <ComboBox fx:id="dayCombo" promptText="Select Day" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" prefWidth="330" prefHeight="40" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Time Slot:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <TextField fx:id="timeField" promptText="e.g., 8:00 AM - 9:30 AM" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" prefHeight="40" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Course Number:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <TextField fx:id="courseNoField" promptText="e.g., CSE 2201" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" prefHeight="40" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Course Name:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <TextField fx:id="courseNameField" promptText="e.g., Advanced Programming" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" prefHeight="40" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Teacher:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <TextField fx:id="teacherField" promptText="Teacher name" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" prefHeight="40" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Room:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <TextField fx:id="roomField" promptText="e.g., AB1-201" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" prefHeight="40" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Year:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <ComboBox fx:id="yearCombo" promptText="Select Year" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" prefWidth="160" prefHeight="40" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Term:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <ComboBox fx:id="termCombo" promptText="Select Term" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" prefWidth="160" prefHeight="40" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Department:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <ComboBox fx:id="departmentCombo" promptText="Select Dept" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" prefWidth="160" prefHeight="40" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Section:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <ComboBox fx:id="sectionCombo" promptText="Select Section" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" prefWidth="160" prefHeight="40" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15" alignment="CENTER">
                    <padding>
                        <Insets top="20.0" />
                    </padding>
                    <children>
                        <Button text="Add to Routine" onAction="#handleSubmit" styleClass="admin-submit-button" stylesheets="@CSS/admin_dashboard.css" prefWidth="180" prefHeight="45" />
                        <Button text="Clear Form" onAction="#clearForm" styleClass="admin-cancel-button" stylesheets="@CSS/admin_dashboard.css" prefWidth="180" prefHeight="45" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>

