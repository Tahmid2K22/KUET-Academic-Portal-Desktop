<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" stylesheets="@CSS/assignments.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kuet_academic_portal_desktop.Controller.AssignmentsController">

    <VBox spacing="15" style="-fx-background-color: #ecf0f1;">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- Header Section -->
        <HBox alignment="CENTER" style="-fx-background-color: #2c3e50; -fx-background-radius: 8;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <VBox alignment="CENTER" spacing="5">
                <Label text="Assignments" textFill="white">
                    <font>
                        <Font name="System Bold" size="28" />
                    </font>
                </Label>
                <Label fx:id="semesterLabel" text="2-1 CSE" textFill="#ecf0f1">
                    <font>
                        <Font size="14" />
                    </font>
                </Label>
            </VBox>
        </HBox>


        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
            <Label style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2c3e50;" text="Your Assignments" />


            <Label fx:id="noAssignmentsLabel" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14; -fx-padding: 20;" text="No assignments available at the moment." visible="false" />

            <!-- Assignments Scroll Container -->
            <ScrollPane fx:id="assignmentsScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="assignmentsContainer" spacing="15" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets bottom="10" left="5" right="5" top="5" />
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>


        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #34495e; -fx-padding: 10; -fx-background-radius: 5;">
            <children>
                <Button fx:id="goDash" mnemonicParsing="false" onAction="#goDashFun" style="-fx-background-color: #2C3E50; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 8 15 8 15; -fx-cursor: hand;" text="Back to Dashboard" wrapText="true" />
            </children>
        </HBox>

    </VBox>

</StackPane>

