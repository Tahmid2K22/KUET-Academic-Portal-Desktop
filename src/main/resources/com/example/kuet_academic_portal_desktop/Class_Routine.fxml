<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" stylesheets="@CSS/classroutine.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kuet_academic_portal_desktop.Controller.ClassRoutineController">

    <VBox spacing="15" style="-fx-background-color: #ecf0f1;">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- Header Section -->
        <HBox alignment="CENTER" style="-fx-background-color: #2c3e50; -fx-background-radius: 8;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <VBox alignment="CENTER" spacing="5">
                <Label text="Class Routine" textFill="white">
                    <font>
                        <Font name="System Bold" size="28" />
                    </font>
                </Label>
                <Label fx:id="semesterLabel" text="2-1 CSE" textFill="#ecf0f1">
                    <font>
                        <Font size="14" />
                    </font>
                </Label>
            </VBox>
        </HBox>

        <!-- Routine Table Section -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
            <Label style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2c3e50;" text="Weekly Schedule" />

            <TableView fx:id="routineTableView" style="-fx-background-color: white; -fx-table-cell-border-color: #bdc3c7;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dayColumn" prefWidth="100" sortable="false" style="-fx-alignment: CENTER; -fx-font-weight: bold;" text="Day" />
                    <TableColumn fx:id="slot1Column" prefWidth="150" sortable="false" style="-fx-alignment: CENTER;" text="8:00 - 9:00 AM" />
                    <TableColumn fx:id="slot2Column" prefWidth="150" sortable="false" style="-fx-alignment: CENTER;" text="9:00 - 10:00 AM" />
                    <TableColumn fx:id="slot3Column" prefWidth="150" sortable="false" style="-fx-alignment: CENTER;" text="10:00 - 11:00 AM" />
                    <TableColumn fx:id="slot4Column" prefWidth="150" sortable="false" style="-fx-alignment: CENTER;" text="11:00 - 12:00 PM" />
                    <TableColumn fx:id="slot5Column" prefWidth="150" sortable="false" style="-fx-alignment: CENTER;" text="12:00 - 1:00 PM" />
                    <TableColumn fx:id="slot6Column" prefWidth="150" sortable="false" style="-fx-alignment: CENTER;" text="2:00 - 3:00 PM" />
                </columns>
                <placeholder>
                    <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 14;" text="No routine data available." />
                </placeholder>
            </TableView>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #34495e; -fx-padding: 10; -fx-background-radius: 5;">
         <children>
            <Button fx:id="goDash" mnemonicParsing="false" onAction="#goDashFun" style="-fx-background-color: #2C3E50;" text="Back to Dashboard" textFill="WHITE" />
         </children>
        </HBox>

    </VBox>

</StackPane>
