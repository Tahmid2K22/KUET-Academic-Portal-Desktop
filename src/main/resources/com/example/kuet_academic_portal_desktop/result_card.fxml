<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="resultCard" spacing="10" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="15" left="20" right="20" top="15" />
    </padding>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label fx:id="courseTitleLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-wrap-text: true;" text="Algorithm Analysis" wrapText="true" HBox.hgrow="ALWAYS">
            <font>
                <Font name="System Bold" size="16" />
            </font>
        </Label>
        <Label fx:id="percentageLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #27ae60; -fx-padding: 5 15; -fx-background-radius: 5;" text="85%">
            <font>
                <Font name="System Bold" size="18" />
            </font>
        </Label>
    </HBox>

    <HBox spacing="40">
        <VBox spacing="5">
            <Label text="Obtained Marks" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;">
                <font>
                    <Font size="11" />
                </font>
            </Label>
            <Label fx:id="obtainedMarksLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="85">
                <font>
                    <Font name="System Bold" size="14" />
                </font>
            </Label>
        </VBox>

        <VBox spacing="5">
            <Label text="Total Marks" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;">
                <font>
                    <Font size="11" />
                </font>
            </Label>
            <Label fx:id="totalMarksLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="100">
                <font>
                    <Font name="System Bold" size="14" />
                </font>
            </Label>
        </VBox>

        <VBox spacing="5">
            <Label text="Grade" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;">
                <font>
                    <Font size="11" />
                </font>
            </Label>
            <Label fx:id="gradeLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="A">
                <font>
                    <Font name="System Bold" size="14" />
                </font>
            </Label>
        </VBox>
    </HBox>
</VBox>

