<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="195.0" spacing="10.0" style="-fx-background-color: #2c3e50; -fx-padding: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 8, 0, 0, 3);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kuet_academic_portal_desktop.Controller.NoticeCardController">

    <Label fx:id="title" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" text="Winter vacation" textFill="WHITE" wrapText="true">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Label>

    <Label fx:id="desc" style="-fx-font-size: 13px; -fx-text-fill: white;" text="winter vaction is starting from tuesday" wrapText="true" />

    <Label fx:id="date" style="-fx-font-size: 10px; -fx-text-fill: white;" text="10 Dec,2025 3;00PM" wrapText="true" />

</VBox>
