<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.kuet_academic_portal_desktop.Controller.dashboardController"
           prefWidth="1200"
           prefHeight="800">

    <AnchorPane>

        <AnchorPane prefWidth="300"
                    style="-fx-background-color: #2C3E50;"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0">

            <Label layoutX="86" layoutY="60" text="Welcome" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="29"/>
                </font>
            </Label>

            <Label fx:id="name_label"
                   layoutX="7"
                   layoutY="120"
                   prefWidth="284"
                   alignment="CENTER"
                   textFill="WHITE"
                   wrapText="true">
                <font>
                    <Font size="19"/>
                </font>
            </Label>

            <VBox spacing="10"
                  layoutY="260"
                  AnchorPane.leftAnchor="15"
                  AnchorPane.rightAnchor="15">

                <Button text="Home" prefWidth="260"
                        styleClass="sidebar-button"
                        stylesheets="@CSS/dashboard.css"
                        wrapText="true"/>

                <Button text="Class Routine" prefWidth="260"
                        onAction="#openClassRoutinePage"
                        styleClass="sidebar-button"
                        stylesheets="@CSS/dashboard.css"
                        wrapText="true"/>

                <Button text="Assignment" prefWidth="260"
                        onAction="#openAssignmentPage"
                        styleClass="sidebar-button"
                        stylesheets="@CSS/dashboard.css"
                        wrapText="true"/>

                <Button text="Contact" prefWidth="260"
                        onAction="#openContactsPage"
                        styleClass="sidebar-button"
                        stylesheets="@CSS/dashboard.css"
                        wrapText="true"/>

                <Button text="Attendance" prefWidth="260"
                        onAction="#openAttendancePage"
                        styleClass="sidebar-button"
                        stylesheets="@CSS/dashboard.css"
                        wrapText="true"/>

                <Button text="Notice" prefWidth="260"
                        onAction="#openNoticesPage"
                        styleClass="sidebar-button"
                        stylesheets="@CSS/dashboard.css"
                        wrapText="true"/>

                <Button text="Results" prefWidth="260"
                        onAction="#openResultsPage"
                        styleClass="sidebar-button"
                        stylesheets="@CSS/dashboard.css"
                        wrapText="true"/>

                <Button text="Logout" prefWidth="260"
                        onAction="#handleLogout"
                        styleClass="sidebar-button"
                        stylesheets="@CSS/dashboard.css"
                        wrapText="true"/>
            </VBox>
        </AnchorPane>

        <ScrollPane fitToWidth="true"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="300"
                    AnchorPane.rightAnchor="0">

            <content>
                <AnchorPane prefWidth="900">

                    <VBox layoutX="80"
                          layoutY="30"
                          prefWidth="300"
                          alignment="CENTER"
                          spacing="15"
                          styleClass="dashboard-card"
                          stylesheets="@CSS/dashboard.css">

                        <Label text="Semester Status"
                               style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

                        <Label fx:id="cyclesLabel"
                               text="Week: 10"
                               style="-fx-text-fill: white; -fx-font-size: 40px; -fx-font-weight: bold;">
                            <font>
                                <Font size="63"/>
                            </font>
                        </Label>

                        <Label fx:id="weekLabel"
                               style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                    </VBox>

                    <VBox layoutX="460"
                          layoutY="30"
                          prefWidth="300"
                          alignment="CENTER"
                          spacing="15"
                          styleClass="dashboard-card"
                          stylesheets="@CSS/dashboard.css">

                        <Label text="Term final after"
                               style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

                        <Label fx:id="tf_remaining"
                               style="-fx-text-fill: white; -fx-font-size: 40px; -fx-font-weight: bold;">
                            <font>
                                <Font size="63"/>
                            </font>
                        </Label>

                        <Label text="Days"
                               style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                    </VBox>

                    <Label layoutX="38" layoutY="300" text="Latest Notices">
                        <font>
                            <Font name="System Bold Italic" size="30"/>
                        </font>
                    </Label>

                    <Separator layoutX="26" layoutY="340" prefWidth="800"/>

                    <HBox fx:id="noticeContainer"
                          layoutX="26"
                          layoutY="360"
                          spacing="10">
                        <padding>
                            <Insets right="10"/>
                        </padding>
                    </HBox>

                    <Label layoutX="38" layoutY="600" text="Recent Results">
                        <font>
                            <Font name="System Bold Italic" size="30"/>
                        </font>
                    </Label>

                    <Separator layoutX="26" layoutY="640" prefWidth="800"/>

                    <VBox layoutX="26"
                          layoutY="670"
                          prefWidth="850"
                          spacing="10"
                          style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">

                        <BarChart fx:id="resultsHistogram"
                                  legendVisible="false"
                                  prefHeight="250"
                                  prefWidth="820">

                            <xAxis>
                                <CategoryAxis label="Courses"/>
                            </xAxis>

                            <yAxis>
                                <NumberAxis label="Percentage (%)"
                                            lowerBound="0"
                                            upperBound="100"
                                            tickUnit="20"
                                            autoRanging="false"/>
                            </yAxis>
                        </BarChart>

                        <Label fx:id="emptyResultsLabel"
                               text="No results available"
                               visible="false"
                               alignment="CENTER"
                               style="-fx-text-fill: #95a5a6; -fx-font-size: 12px;"/>
                    </VBox>

                </AnchorPane>
            </content>
        </ScrollPane>
    </AnchorPane>
</StackPane>
