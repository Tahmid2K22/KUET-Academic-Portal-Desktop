<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxWidth="Infinity" prefWidth="1100.0" spacing="12.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kuet_academic_portal_desktop.Controller.NoticeCardController">


    <Label fx:id="title" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Notice Title" wrapText="true">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>


    <Label fx:id="desc" style="-fx-font-size: 16px; -fx-text-fill: #34495E; -fx-line-spacing: 2px;" text="description" wrapText="true">
        <font>
            <Font size="16.0" />
        </font>
    </Label>
   <Label fx:id="date" style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D; -fx-font-weight: bold; -fx-background-color: #ECF0F1;" text="20 Dec, 2025">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Label>

</VBox>
