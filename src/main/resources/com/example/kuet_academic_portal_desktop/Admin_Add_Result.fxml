<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kuet_academic_portal_desktop.Controller.AdminDashboardController$AddResultController">
    <padding>
        <Insets top="30.0" left="50.0" right="50.0" bottom="30.0" />
    </padding>
    <children>
        <Label text="Add Student Result" styleClass="form-title" stylesheets="@CSS/admin_dashboard.css">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <VBox spacing="20" styleClass="admin-form-container" stylesheets="@CSS/admin_dashboard.css" prefWidth="700">
            <padding>
                <Insets top="30.0" left="30.0" right="30.0" bottom="30.0" />
            </padding>
            <children>
                <VBox spacing="8">
                    <children>
                        <Label text="Student Roll:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                        <TextField fx:id="rollField" promptText="e.g., 2207109" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" prefHeight="40" />
                    </children>
                </VBox>

                <VBox spacing="8">
                    <children>
                        <Label text="Course/Exam Title:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                        <TextField fx:id="courseNameField" promptText="e.g., Advanced Programming" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" prefHeight="40" />
                    </children>
                </VBox>

                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Obtained Marks:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <TextField fx:id="ctMarksField" promptText="e.g., 85" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" prefHeight="40" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Total Marks:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <TextField fx:id="attendanceMarksField" promptText="e.g., 100" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" prefHeight="40" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Year:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <ComboBox fx:id="yearCombo" promptText="Select Year" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" prefWidth="330" prefHeight="40" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Term:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <ComboBox fx:id="termCombo" promptText="Select Term" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" prefWidth="330" prefHeight="40" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15" alignment="CENTER">
                    <padding>
                        <Insets top="20.0" />
                    </padding>
                    <children>
                        <Button text="Add Result" onAction="#handleSubmit" styleClass="admin-submit-button" stylesheets="@CSS/admin_dashboard.css" prefWidth="180" prefHeight="45" />
                        <Button text="Clear Form" onAction="#clearForm" styleClass="admin-cancel-button" stylesheets="@CSS/admin_dashboard.css" prefWidth="180" prefHeight="45" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>

