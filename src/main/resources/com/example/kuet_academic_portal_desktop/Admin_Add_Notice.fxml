<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kuet_academic_portal_desktop.Controller.AdminDashboardController$AddNoticeController">
    <padding>
        <Insets top="30.0" left="50.0" right="50.0" bottom="30.0" />
    </padding>
    <children>
        <Label text="Add New Notice" styleClass="form-title" stylesheets="@CSS/admin_dashboard.css">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <VBox spacing="20" styleClass="admin-form-container" stylesheets="@CSS/admin_dashboard.css" prefWidth="700">
            <padding>
                <Insets top="30.0" left="30.0" right="30.0" bottom="30.0" />
            </padding>
            <children>
                <VBox spacing="8">
                    <children>
                        <Label text="Notice Title:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                        <TextField fx:id="titleField" promptText="Enter notice title" styleClass="admin-text-field" stylesheets="@CSS/admin_dashboard.css" prefHeight="40" />
                    </children>
                </VBox>

                <VBox spacing="8">
                    <children>
                        <Label text="Description:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                        <TextArea fx:id="descriptionArea" promptText="Enter notice description" styleClass="admin-text-area" stylesheets="@CSS/admin_dashboard.css" prefHeight="150" wrapText="true" />
                    </children>
                </VBox>

                <VBox spacing="8">
                    <children>
                        <Label text="Date:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                        <DatePicker fx:id="datePicker" promptText="Select date" styleClass="date-picker" stylesheets="@CSS/admin_dashboard.css" prefHeight="40" />
                    </children>
                </VBox>

                <HBox spacing="15">
                    <children>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Year:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <ComboBox fx:id="yearCombo" promptText="All Years" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" prefWidth="330" prefHeight="40" />
                            </children>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Term:" styleClass="form-label" stylesheets="@CSS/admin_dashboard.css" />
                                <ComboBox fx:id="termCombo" promptText="All Terms" styleClass="admin-combo-box" stylesheets="@CSS/admin_dashboard.css" prefWidth="330" prefHeight="40" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15" alignment="CENTER">
                    <padding>
                        <Insets top="20.0" />
                    </padding>
                    <children>
                        <Button text="Publish Notice" onAction="#handleSubmit" styleClass="admin-submit-button" stylesheets="@CSS/admin_dashboard.css" prefWidth="180" prefHeight="45" />
                        <Button text="Clear Form" onAction="#clearForm" styleClass="admin-cancel-button" stylesheets="@CSS/admin_dashboard.css" prefWidth="180" prefHeight="45" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>

